        {
          "name": "GET /market/history",
          "request": { "method": "GET", "url": "{{quantUrl}}/market/history?tickers=AAPL&period=1mo&interval=1d" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status is 200 or 503 (network dependent)', () => {",
            "  pm.expect([200, 503]).to.include(pm.response.code);",
            "});"
          ] } }]
        }
      ]
    }
  ]
}
