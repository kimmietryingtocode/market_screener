POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=portfolio
JWT_SECRET=replace-with-a-long-random-local-secret
# Public OAuth Web client identifier. Sign in with Google does not use a client secret.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI provider: gemini for public/demo data, ollama for private backtests.
AI_PROVIDER=gemini
AI_GEMINI_DATA_POLICY=public_only
GOOGLE_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
AI_MODEL=qwen3:4b
AI_EMBEDDING_MODEL=nomic-embed-text:v1.5
AI_CONTEXT_TOKENS=4096
AI_MODEL_TIMEOUT_SECONDS=180
AI_JOB_TIMEOUT_SECONDS=600
LANGSMITH_TRACING=false

# --- Production deploy (docker-compose.prod.yml) ---
# Public hostname Caddy serves. A bare hostname makes Caddy obtain and renew
# a Let's Encrypt certificate automatically; ":80" serves plain HTTP, which
# is only appropriate for a local check.
SITE_ADDRESS=:80
# Contact address Let's Encrypt uses for expiry notices. Required for TLS.
ACME_EMAIL=
# Empty in production: Caddy serves the frontend and the API on one origin,
# so there is no cross-origin request to permit.
CORS_ORIGINS=
